# Frontend & Ecosystem
VITE_COLLAB_ROOMS_URL=https://utkristi-colabs.vercel.app/
VITE_API_BASE_URL=
VITE_DEFAULT_PROFILE=default
VITE_CUSTOM_PLAYER_URL=

# Reserved for the client sign-in integration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Firebase Admin / JWT Verification (Backend - Optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Reserved for the cloud persistence integration
DATABASE_URL=

# Rate Limiting (Upstash Redis REST - Optional, falls back to in-memory sliding window)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pagination
PROBLEMS_PER_PAGE=20
RESOURCES_PER_PAGE=12

# Backend Server & Security
PORT=4000
HOST=127.0.0.1
ALLOWED_ORIGINS=https://codegrill.vercel.app,http://localhost:5173,http://127.0.0.1:5173
REQUIRE_AUTH=true
DATA_STORE_PATH=

# Content & Video Plugins
PLUGIN_CACHE_TTL_MS=600000
PLUGIN_FETCH_TIMEOUT_MS=9000

# Study Planner & Interview Defaults
PLANNER_MIN_WEEKS=2
PLANNER_MAX_WEEKS=16
PLANNER_DEFAULT_WEEKS=8
PLANNER_MIN_HOURS=2
PLANNER_MAX_HOURS=24
PLANNER_DEFAULT_HOURS=8
DIFFICULTY_MINUTES_EASY=20
DIFFICULTY_MINUTES_MEDIUM=35
DIFFICULTY_MINUTES_HARD=50
INTERVIEW_TIMER_MINUTES=35
ACTIVITY_LEDGER_DAYS=28
